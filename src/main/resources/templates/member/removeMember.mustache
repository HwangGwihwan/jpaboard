<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>회원탈퇴</title>
	<!-- Bootstrap CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		body {
			background-color: #f8f9fa;
		}
		.card {
			border-radius: 1rem;
			box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
			background-color: #ffffff;
			padding: 2rem;
		}
		h2 {
			font-weight: 600;
			color: #343a40;
		}
		label {
			font-weight: 500;
		}
		.form-control:focus {
			border-color: #dc3545;
			box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
		}
		.btn-danger {
			font-weight: bold;
			padding: 0.6rem;
			font-size: 1rem;
		}
		.alert {
			font-size: 0.95rem;
		}
	</style>
</head>
<body>

	{{>layouts/header}}

	<div class="container py-5">
		<div class="row justify-content-center">
			<div class="col-md-6">
				<div class="card">
					<h2 class="text-center mb-4">회원탈퇴</h2>

					{{#msg}}
						<div class="alert alert-warning text-center">{{msg}}</div>
					{{/msg}}

					{{#member}}
					<form action="/member/removeMember" method="post">
						<input type="hidden" name="memberNo" value="{{memberNo}}">

						<div class="mb-3">
							<label for="memberId" class="form-label">아이디</label>
							<input type="text" id="memberId" name="memberId" class="form-control" value="{{memberId}}" readonly>
						</div>

						<div class="mb-3">
							<label for="memberPw" class="form-label">비밀번호 확인</label>
							<input type="password" id="memberPw" name="memberPw" class="form-control" placeholder="비밀번호를 입력하세요" required>
						</div>

						<div class="d-grid">
							<button type="submit" class="btn btn-danger">회원탈퇴</button>
						</div>
					</form>
					{{/member}}

				</div>
			</div>
		</div>
	</div>

	{{>layouts/footer}}

</body>
</html>
