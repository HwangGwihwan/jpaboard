<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>멤버 목록</title>
	<!-- Bootstrap CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		body {
			background-color: #f8f9fa;
		}
		.card {
			border-radius: 1rem;
			box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
		}
	</style>
</head>
<body>

	{{>layouts/header}}

	<div class="container py-5">
		<h2 class="text-center mb-4">멤버 목록</h2>

		{{#memberList}}
		<div class="card mb-3 p-3">
			<p class="mb-2"><strong>{{memberId}}
		</div>
		{{/memberList}}
		
		{{member.memberId}}</strong>님 반갑습니다 😊</p>
		<div class="d-flex flex-wrap gap-2">
			<a href="/member/logout" class="btn btn-outline-secondary btn-sm">로그아웃</a>
			<a href="/member/modifyMemberPw" class="btn btn-outline-primary btn-sm">비밀번호 수정</a>
			<a href="/member/removeMember" class="btn btn-outline-danger btn-sm">회원 탈퇴</a>
		</div>

		<!-- 검색 폼 -->
		<form action="/member/memberList" method="get" class="input-group mb-4">
			<input type="text" name="word" class="form-control" placeholder="회원 검색" value="{{word}}">
			<button type="submit" class="btn btn-dark">검색</button>
		</form>

		<!-- 페이지네이션 -->
		<nav class="d-flex justify-content-center">
			<ul class="pagination">
				{{^memberList.isFirst}}
					<li class="page-item">
						<a class="page-link" href="/member/memberList?currentPage={{prePage}}&word={{word}}">이전</a>
					</li>
				{{/memberList.isFirst}}

				<li class="page-item active">
					<span class="page-link">{{memberList.getNumber}}</span>
				</li>

				{{#memberList.hasNext}}
					<li class="page-item">
						<a class="page-link" href="/member/memberList?currentPage={{nextPage}}&word={{word}}">다음</a>
					</li>
				{{/memberList.hasNext}}
			</ul>
		</nav>
	</div>

	{{>layouts/footer}}

</body>
</html>
