<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <title>Board List</title>

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        table.table {
            background-color: #ffffff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            border-radius: 12px;
            overflow: hidden;
        }

        table th, table td {
            vertical-align: middle;
            text-align: center;
        }

        table th {
            background-color: #e9ecef;
        }

        a {
            text-decoration: none;
            color: #0d6efd;
            transition: color 0.2s;
        }

        a:hover {
            color: #0a58ca;
        }

        div.pagination {
            margin-top: 20px;
            text-align: center;
        }

        div.pagination a {
            margin: 0 8px;
            padding: 6px 12px;
            background-color: #ffffff;
            border: 1px solid #dee2e6;
            border-radius: 8px;
        }

        div.pagination a:hover {
            background-color: #e2e6ea;
        }

        form {
            margin-top: 20px;
            display: flex;
            justify-content: center;
            gap: 10px;
        }

        input[type="text"] {
            padding: 8px 12px;
            border: 1px solid #ced4da;
            border-radius: 8px;
            width: 250px;
        }

        button[type="submit"] {
            padding: 8px 16px;
            border: none;
            background-color: #0d6efd;
            color: #fff;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        button[type="submit"]:hover {
            background-color: #0b5ed7;
        }

        .new-board-link {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 20px;
            background-color: #198754;
            color: #ffffff;
            border-radius: 8px;
            text-align: center;
        }

        .new-board-link:hover {
            background-color: #157347;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
        }
    </style>
</head>
<body>
    {{>layouts/header}}

    <div class="container">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">BoardNo</th>
                    <th scope="col">BoardTitle</th>
                    <th scope="col">BoardContent</th>
                </tr>
            </thead>
            <tbody>
                {{#boardList}}
                    <tr>
                        <th>{{boardNo}}</th>
                        <td><a href="/board/boardOne?boardNo={{boardNo}}">{{boardTitle}}</a></td>
                        <td>{{boardContent}}</td>
                    </tr>
                {{/boardList}}
            </tbody>
        </table>

        <div class="pagination">
            {{^boardList.isFirst}}
                <a href="/board/boardList?currentPage={{prePage}}&word={{word}}">이전</a>
            {{/boardList.isFirst}}

            <span>{{boardList.getNumber}}</span>

            {{#boardList.hasNext}}
                <a href="/board/boardList?currentPage={{nextPage}}&word={{word}}">다음</a>
            {{/boardList.hasNext}}
        </div>

        <form action="/board/boardList" method="get">
            <input type="text" name="word" placeholder="검색어를 입력하세요">
            <button type="submit">검색</button>
        </form>

        <a href="/board/addBoard" class="new-board-link">New Board</a>
    </div>

    {{>layouts/footer}}
</body>
</html>
