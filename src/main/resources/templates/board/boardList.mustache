<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
	<title>Insert title here</title>
</head>
<body>
	{{>layouts/header}}
	
	<table class="table">
	    <thead>
	    <tr>
	        <th scope="col">BoardNo</th>
	        <th scope="col">BoardTitle</th>
	        <th scope="col">BoardContent</th>
	    </tr>
	    </thead>
	    <tbody>
	    {{#boardList}}
	        <tr>
	            <th>{{boardNo}}</th>
	            <td><a href="/board/boardOne?boardNo={{boardNo}}">{{boardTitle}}</a></td>
	            <td>{{boardContent}}</td>
	        </tr>
	    {{/boardList}}
	    </tbody>
	</table>
	
	<div>
		{{^boardList.isFirst}}
			<a href="/board/boardList?currentPage={{prePage}}&word={{word}}">이전</a>
		{{/boardList.isFirst}}
		
		{{boardList.getNumber}}
		
		{{#boardList.hasNext}}
			<a href="/board/boardList?currentPage={{nextPage}}&word={{word}}">다음</a>
		{{/boardList.hasNext}}
	</div>
	
	<form action="/board/boardList" method="get">
		<input type="text" name="word">
		<button type="submit">검색</button>
	</form>
	
	<a href="/board/addBoard">New Board</a>
	
	{{>layouts/footer}}
</body>
</html>