<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
	<title>Update Board</title>

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .form-container {
            max-width: 700px;
            margin: 40px auto;
            background-color: #ffffff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        }

        label.form-label {
            font-weight: 600;
        }

        input.form-control, textarea.form-control {
            border-radius: 8px;
            border: 1px solid #ced4da;
        }

        button[type="submit"] {
            background-color: #0d6efd;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            color: #ffffff;
            transition: background-color 0.2s;
        }

        button[type="submit"]:hover {
            background-color: #0b5ed7;
        }
    </style>
</head>
<body>
	{{>layouts/header}}

	{{#board}}
	<form class="form-container" action="/board/updateBoard" method="post">
	    <input name="boardNo" type="hidden" value="{{boardNo}}">
	    
	    <div class="mb-3">
	        <label class="form-label">제목</label>
	        <input type="text" class="form-control" name="boardTitle" value="{{boardTitle}}" required>
	    </div>
	    
	    <div class="mb-3">
	        <label class="form-label">내용</label>
	        <textarea class="form-control" rows="5" name="boardContent" required>{{boardContent}}</textarea>
	    </div>
	    
	    <button type="submit">Submit</button>
	</form>
	{{/board}}

	{{>layouts/footer}}
</body>
</html>
