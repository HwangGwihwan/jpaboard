<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>홈페이지</title>
	<!-- Bootstrap CSS -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<style>
		body {
			background-color: #f8f9fa;
		}
		.link-card {
			transition: transform 0.2s ease;
		}
		.link-card:hover {
			transform: scale(1.03);
		}
	</style>
</head>
<body>

	<!-- header.mustache include -->
	{{>layouts/header}}

	<div class="container py-5">
		<h2 class="text-center mb-4">메뉴</h2>
		<div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center">

			<div class="col">
				<div class="card link-card shadow-sm text-center">
					<div class="card-body">
						<h5 class="card-title">Article 리스트</h5>
						<a href="/articles/index" class="btn btn-primary">이동하기</a>
					</div>
				</div>
			</div>

			<div class="col">
				<div class="card link-card shadow-sm text-center">
					<div class="card-body">
						<h5 class="card-title">Board 리스트</h5>
						<a href="/board/boardList" class="btn btn-primary">이동하기</a>
					</div>
				</div>
			</div>

			<div class="col">
				<div class="card link-card shadow-sm text-center">
					<div class="card-body">
						<h5 class="card-title">회원가입</h5>
						<a href="/member/joinMember" class="btn btn-success">가입하기</a>
					</div>
				</div>
			</div>

			<div class="col">
				<div class="card link-card shadow-sm text-center">
					<div class="card-body">
						<h5 class="card-title">로그인</h5>
						<a href="/member/login" class="btn btn-dark">로그인</a>
					</div>
				</div>
			</div>

		</div>
	</div>

	<!-- footer.mustache include -->
	{{>layouts/footer}}

</body>
</html>
